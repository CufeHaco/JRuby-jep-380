+        if (bytes[0] == 0) {
+            int end = 1;
+            while (end < bytes.length && bytes[end] != 0) end++;
+            return end <= 1 ? "" : "\0" + new String(bytes, 1, end - 1);
+        }
+        int end = 0;
+        while (end < bytes.length && bytes[end] != 0) end++;
