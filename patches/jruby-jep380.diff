+    private static MemorySegment sockaddrUn(Arena arena, byte[] pathBytes) {
+        MemorySegment sun = arena.allocate(2 + SUN_PATH); // zero-initialized
+        sun.set(C_BYTE, 0, (byte) AF_UNIX);
